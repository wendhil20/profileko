Options -Indexes
DirectoryIndex portfolio.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Harangin ang direct access sa sensitive folders
   RewriteRule ^(config|routes|includes|pages|storage|helpers|controllers)(/|$) - [F,L]

    # Kapag totoong file (assets) — ibigay agad
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Lahat ng iba — papunta sa portfolio.php
    RewriteRule ^ portfolio.php [QSA,L]
</IfModule>

# Itago ang .env, .gitignore, at iba pang dotfiles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

